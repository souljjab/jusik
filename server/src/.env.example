# web: 네이버 금융(국내) + 야후 파이낸스(미국) 웹사이트에서 수집 / mock: 샘플 데이터(오프라인 데모)
PROVIDER=web
PORT=8787
# 상태 파일(state.json)과 엑셀(jusik.xlsx)을 저장할 폴더. 기본값은 저장소의 data/
# DATA_DIR=
SCHEDULER=on

# 사이트에 주는 부담을 줄이기 위해 요청 사이 최소 간격(ms). 낮추지 않는 것을 권장
HTTP_MIN_INTERVAL_MS=500
# 사이트가 기본 User-Agent를 거부하면 직접 지정
# HTTP_USER_AGENT=

# --- 2차 저장: 구글 스프레드시트(선택) ---
# 1) Google Cloud에서 서비스 계정을 만들고 Sheets API를 켠 뒤 JSON 키를 받는다
# 2) 대상 스프레드시트를 서비스 계정 이메일에 '편집자'로 공유한다
# 3) 아래 두 값을 채운다(키 파일은 저장소에 커밋하지 마세요)
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=
