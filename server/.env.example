# mock(샘플 데이터) | kis(한국투자증권 Open API)
PROVIDER=mock
PORT=8787

# --- PROVIDER=kis 일 때 ---
# https://apiportal.koreainvestment.com 에서 발급. 절대 저장소에 커밋하지 마세요.
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전: https://openapi.koreainvestment.com:9443  / 모의투자: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# 호출 간 최소 간격(ms). 실전 초당 20건, 모의 초당 2건 제한
KIS_MIN_INTERVAL_MS=120

# --- 금융감독원 DART 오픈API(선택) ---
# https://opendart.fss.or.kr 에서 인증키(crtfc_key)를 발급받아 넣으면 국내 공시 목록·정기보고서·연간 주요 계정을 DART에서 받아요.
# 비워 두면 지금처럼 네이버 금융 공시 목록을 써요. 하루 호출 한도(약 2만 건)가 있어요. 절대 저장소에 커밋하지 마세요.
# 회사 고유번호 목록(corpCode.xml)은 처음 한 번 내려받아 데이터 폴더에 7일 동안 캐시해요.
DART_API_KEY=
