# 이 파일을 server/.env 로 복사해서 고쳐 쓰세요. .env 는 저장소에 올라가지 않아요(키·이메일을 넣으니 커밋하지 마세요).

# web: 네이버 금융(국내)·야후 파이낸스(미국)·FRED·ISM 웹사이트에서 읽기 / mock: 오프라인 샘플 데이터(실제 시세 아님)
PROVIDER=web
PORT=8787
# 상태 파일(state.json)·엑셀(jusik.xlsx)·DART 회사 목록 캐시를 둘 폴더. 비우면 저장소의 data/
DATA_DIR=
# off 로 두면 자동 스캔·보유 점검·장 마감 복기를 하지 않아요(수동 버튼만)
SCHEDULER=on

# --- 웹 수집 예절 ---
# 요청 사이 최소 간격(ms). 모든 사이트 요청이 한 줄로 서서 이 간격으로 나가요. 줄이지 않는 것을 권장해요
HTTP_MIN_INTERVAL_MS=500
# 비우면 일반 브라우저와 비슷한 값을 써요
HTTP_USER_AGENT=

# --- 구글 스프레드시트(2차 저장, 선택) ---
# 대상 시트 주소의 /d/ 뒤 값, 서비스 계정 JSON 키 파일 경로(시트를 서비스 계정 이메일에 편집자로 공유)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- 금융감독원 DART 오픈API(선택) ---
# https://opendart.fss.or.kr 에서 인증키(crtfc_key)를 발급받아 넣으면 국내 공시 목록·정기보고서 제출 현황·연간 주요 계정을 DART에서 받아요.
# 비워 두면 네이버 금융 공시 목록을 써요. 하루 호출 한도(약 2만 건)가 있어요.
# 회사 고유번호 목록(corpCode.xml)은 처음 한 번 내려받아 데이터 폴더에 7일 동안 캐시해요.
DART_API_KEY=

# --- 미국 SEC EDGAR(선택) ---
# SEC는 연락처가 들어간 User-Agent를 요구해요. 예: "jusik personal app your@email.com"
# 넣으면 미국 종목의 공시(8-K·10-Q·Form 4 등)와 연간·분기 실적(XBRL)을 SEC에서 받아요. 비우면 미국 공시·실적은 빠져요.
SEC_USER_AGENT=
